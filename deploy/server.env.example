# 复制为 deploy/server.env，填入真实值；此文件不保存真实密钥。
# 域名只填主机名，不含 https://、路径或端口；DNS 需指向服务器。
FACTORY_DOMAIN=
FACTORY_ADMIN_USER=admin
# 用 docker run --rm -it caddy:2.10-alpine caddy hash-password 交互生成。
# 密码哈希包含 $，务必保留单引号，防止 Compose 展开。
FACTORY_ADMIN_PASSWORD_HASH=''
# 用 python3 -c 'import secrets; print(secrets.token_urlsafe(48))' 生成。
FACTORY_PROXY_TOKEN=
SHANJIAN_API_KEY=
SHANJIAN_AVATAR_ID=
SHANJIAN_SPEAKER_ID=
AIGC_CONTENT_PRODUCER=
DASHSCOPE_API_KEY=
PUBLISH_GATEWAY_URL=
PUBLISH_GATEWAY_TOKEN=
PUBLISH_ACCOUNTS='[]'
